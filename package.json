  "keywords": [
    "ioBroker",
    "meter",
    "reading",
    "smart home",
    "esp32",
    "energy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MPunktBPunkt/ioBroker.metermaster.git"
  },
